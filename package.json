{
  "name": "angular-material-template",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start-en": "ng serve",
    "start-fr": "ng serve --configuration=development-fr",
    "build": "ng build",
    "i18n": "ng extract-i18n --output-path src/locale --format=json",
    "circular-check": "madge --circular --extensions ts ./src ",
    "lint": "ng lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build-production": "ng build --configuration=production --base-href=/angular-material-template/"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/material-moment-adapter": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/platform-browser-dynamic": "^22.1.7",
    "@angular/router": "^22.1.7",
    "jwt-decode": "^3.1.2",
    "moment": "2.29.4",
    "ngx-logger": "^5.0.7",
    "rxjs": "~7.5.0",
    "ts-typed": "^1.3.6",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^22.0.1",
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/schematics": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@angular/localize": "^22.1.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^12.20.55",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-preset-angular": "^17.0.0",
    "jsdom": "^30.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
